PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Sécurité Administrateur (obligatoire : au moins 32 caractères pour JWT_SECRET)
# Générer une chaîne aléatoire par exemple avec : openssl rand -base64 32
JWT_SECRET=votre-cle-secrete-jwt-aleatoire-d-au-moins-32-caracteres-a-generer
ADMIN_EMAIL=votre-email-administrateur@domaine.com
ADMIN_PASSWORD=votre-mot-de-passe-solide-d-au-moins-12-caracteres

# Base de données persistante (Neon / Supabase / Vercel Postgres)
# Ex : postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Fichier de données local (utilisé si DATABASE_URL n'est pas renseignée)
DATA_FILE=data/db.json

# Notifications e-mail (facultatif)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=UpesiTech <no-reply@votredomaine.com>
MAIL_TO=contact@votredomaine.com
